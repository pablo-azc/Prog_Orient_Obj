        <ownedAttribute xmi:type="uml:Property" xmi:id="u7qM0XNtlDsl8" name="encendido" comment="Estado del movil. 0 equivale a Detenido, 1 a Encendido" visibility="private" type="uK0oSKLti7TrU" initialValue="0"/>
